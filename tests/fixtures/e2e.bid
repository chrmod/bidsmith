provider "google_ads" {
  customer_id = "0000000000"
}

resource "google_ads_campaign_budget" "main" {
  name = "__PREFIX__budget"
  amount_micros = 1000000
  delivery_method = "STANDARD"
}

resource "google_ads_campaign" "search" {
  name = "__PREFIX__campaign"
  status = "PAUSED"
  advertising_channel_type = "SEARCH"
  campaign_budget = google_ads_campaign_budget.main.id
  contains_eu_political_advertising = "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING"

  manual_cpc {
    enhanced_cpc_enabled = false
  }

  network_settings {
    target_google_search = true
    target_search_network = false
    target_content_network = false
    target_partner_search_network = false
  }
}

resource "google_ads_ad_group" "default" {
  name = "__PREFIX__ag"
  campaign = google_ads_campaign.search.id
  status = "ENABLED"
  type = "SEARCH_STANDARD"
  cpc_bid_micros = 1000000

  targeting_setting {
    target_restriction {
      targeting_dimension = "AUDIENCE"
      bid_only = true
    }

    target_restriction {
      targeting_dimension = "AGE_RANGE"
      bid_only = true
    }

    target_restriction {
      targeting_dimension = "GENDER"
      bid_only = true
    }

    target_restriction {
      targeting_dimension = "PARENTAL_STATUS"
      bid_only = true
    }

    target_restriction {
      targeting_dimension = "INCOME_RANGE"
      bid_only = true
    }
  }
}

resource "google_ads_campaign_budget" "demand_gen" {
  name = "__PREFIX__dg-budget"
  amount_micros = 60000000
  delivery_method = "STANDARD"
}

resource "google_ads_campaign" "demand_gen" {
  name = "__PREFIX__dg-campaign"
  status = "PAUSED"
  advertising_channel_type = "DEMAND_GEN"
  campaign_budget = google_ads_campaign_budget.demand_gen.id
  contains_eu_political_advertising = "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING"

  target_spend {}
}

resource "google_ads_ad_group" "dg_youtube_only" {
  name = "__PREFIX__dg-ag-youtube"
  campaign = google_ads_campaign.demand_gen.id
  status = "ENABLED"

  demand_gen_ad_group_settings {
    channel_controls {
      selected_channels {
        youtube_in_stream = true
        youtube_in_feed = true
        youtube_shorts = true
      }
    }
  }
}

resource "google_ads_ad_group" "dg_owned_operated" {
  name = "__PREFIX__dg-ag-owned"
  campaign = google_ads_campaign.demand_gen.id
  status = "ENABLED"

  demand_gen_ad_group_settings {
    channel_controls {
      channel_strategy = "ALL_OWNED_AND_OPERATED_CHANNELS"
    }
  }
}

resource "google_ads_ad_group_criterion" "kw_widgets" {
  ad_group = google_ads_ad_group.default.id
  status = "ENABLED"

  keyword {
    text = "blue widgets"
    match_type = "PHRASE"
  }
}

resource "google_ads_ad_group_criterion" "kw_gadgets" {
  ad_group = google_ads_ad_group.default.id
  status = "ENABLED"
  cpc_bid_micros = 1500000

  keyword {
    text = "red gadgets"
    match_type = "EXACT"
  }
}

resource "google_ads_campaign_criterion" "neg_clearance" {
  campaign = google_ads_campaign.search.id
  status = "ENABLED"
  negative = true

  keyword {
    text = "clearance"
    match_type = "BROAD"
  }
}

resource "google_ads_ad_group_ad" "rsa" {
  ad_group = google_ads_ad_group.default.id
  status = "ENABLED"

  ad {
    name = "__PREFIX__rsa"
    final_urls = ["https://example.com/widgets"]

    responsive_search_ad {
      headline {
        text = "Blue Widgets In Stock"
        pin = "HEADLINE_1"
      }

      headline {
        text = "Order Online Today"
      }

      headline {
        text = "Free Shipping Available"
      }

      description {
        text = "Premium blue widgets for every project."
      }

      description {
        text = "Order before 3pm for next-day delivery."
      }

      path1 = "widgets"
      path2 = "blue"
    }
  }
}
