provider "google_ads" {
  customer_id = "1234567890"
}

resource "google_ads_youtube_video_asset" "brand_12s" {
  youtube_video_id = "dQw4w9WgXcQ"
  youtube_video_title = "Ghostery — Block Ads & Trackers (12s)"
}

resource "google_ads_custom_audience" "privacy_searchers" {
  name = "Privacy tool searchers"
  description = "People searching for ad and tracker blocking"
  type = "SEARCH"

  member {
    keyword = "ad blocker"
  }

  member {
    keyword = "block trackers"
  }

  member {
    keyword = "stop being tracked online"
  }
}

resource "google_ads_campaign_budget" "preroll" {
  name = "Instream Preroll India 12sec"
  amount_micros = 10000000
}

resource "google_ads_campaign" "preroll" {
  name = "Instream Preroll India 12sec"
  status = "PAUSED"
  advertising_channel_type = "VIDEO"
  campaign_budget = google_ads_campaign_budget.preroll.id
  contains_eu_political_advertising = "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING"
  languages = ["en"]
  locations = ["IN"]

  lifecycle {
    create = false
  }

  manual_cpv {}

  network_settings {
    target_google_search = false
    target_search_network = false
    target_content_network = false
    target_partner_search_network = false
  }

  frequency_caps {
    event_type = "IMPRESSION"
    time_unit = "DAY"
    time_length = 1
    cap = 3
  }

  frequency_caps {
    event_type = "VIDEO_VIEW"
    time_unit = "DAY"
    time_length = 1
    cap = 1
  }
}

resource "google_ads_campaign_criterion" "privacy_intent" {
  campaign = google_ads_campaign.preroll.id

  audience {
    custom_audience = google_ads_custom_audience.privacy_searchers.id
  }
}

resource "google_ads_campaign_criterion" "computers_topic" {
  campaign = google_ads_campaign.preroll.id

  topic {
    topic_constant = "topicConstants/278"
  }
}

resource "google_ads_campaign_criterion" "exclude_under_25" {
  campaign = google_ads_campaign.preroll.id
  negative = true

  age_range {
    type = "AGE_RANGE_18_24"
  }
}

resource "google_ads_ad_group" "instream" {
  name = "In-stream"
  campaign = google_ads_campaign.preroll.id
  type = "VIDEO_TRUE_VIEW_IN_STREAM"
  cpv_bid_micros = 30000
}

resource "google_ads_ad_group_ad" "preroll" {
  ad_group = google_ads_ad_group.instream.id
  status = "PAUSED"

  ad {
    name = "Preroll 12s"
    final_urls = [
      "https://www.ghostery.com/ghostery-ad-blocker?utm_source=youtube&utm_campaign=12sec_india",
    ]

    video_responsive_ad {
      video = google_ads_youtube_video_asset.brand_12s.id
      headlines = ["Block Ads & Trackers"]
      long_headlines = ["Ghostery blocks ads and trackers on every site"]
      descriptions = ["Install the free privacy extension in one click."]
      call_to_actions = ["Install"]
    }
  }
}

# The 35+ cohort: same budget, same creative, a narrower audience. Targeting
# the cohort on the ad group keeps it a second ad group here rather than a
# second campaign.
resource "google_ads_ad_group" "instream_35_up" {
  name = "In-stream — 35+"
  campaign = google_ads_campaign.preroll.id
  type = "VIDEO_TRUE_VIEW_IN_STREAM"
  cpv_bid_micros = 35000
}

resource "google_ads_ad_group_criterion" "cohort_35_44" {
  ad_group = google_ads_ad_group.instream_35_up.id

  age_range {
    type = "AGE_RANGE_35_44"
  }
}

resource "google_ads_ad_group_criterion" "cohort_45_54" {
  ad_group = google_ads_ad_group.instream_35_up.id

  age_range {
    type = "AGE_RANGE_45_54"
  }
}

resource "google_ads_ad_group_criterion" "cohort_tech_channel" {
  ad_group = google_ads_ad_group.instream_35_up.id

  youtube_channel {
    channel_id = "UCXuqSBlHAE6Xw-yeJA0Tunw"
  }
}

resource "google_ads_ad_group_ad" "preroll_35_up" {
  ad_group = google_ads_ad_group.instream_35_up.id
  status = "PAUSED"

  ad {
    name = "Preroll 12s — 35+"
    final_urls = [
      "https://www.ghostery.com/ghostery-ad-blocker?utm_source=youtube&utm_campaign=12sec_india_35up",
    ]

    video_responsive_ad {
      video = google_ads_youtube_video_asset.brand_12s.id
      headlines = ["Block Ads & Trackers"]
      long_headlines = ["Ghostery blocks ads and trackers on every site"]
      descriptions = ["Install the free privacy extension in one click."]
      call_to_actions = ["Install"]
    }
  }
}
