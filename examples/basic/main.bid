provider "google_ads" {
  customer_id = "1234567890"
  login_customer_id = "9876543210"
}

resource "google_ads_campaign_budget" "summer" {
  name = "Summer 2026"
  amount_micros = 10000000
  delivery_method = "STANDARD"
}

resource "google_ads_campaign" "summer_search" {
  name = "Summer 2026 — Search"
  status = "PAUSED"
  advertising_channel_type = "SEARCH"
  campaign_budget = google_ads_campaign_budget.summer.id
  contains_eu_political_advertising = "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING"
  languages = ["pl"]
  locations = ["US"]

  manual_cpc {
    enhanced_cpc_enabled = false
  }

  network_settings {
    target_google_search = true
    target_search_network = false
    target_content_network = false
    target_partner_search_network = false
  }

  geo_target_type_setting {
    positive_geo_target_type = "PRESENCE"
    negative_geo_target_type = "PRESENCE"
  }
}

resource "google_ads_ad_group" "summer_search_default" {
  name = "Default"
  campaign = google_ads_campaign.summer_search.id
  status = "ENABLED"
  type = "SEARCH_STANDARD"
  cpc_bid_micros = 2000000
}

resource "google_ads_ad_group_criterion" "summer_kw_summer_deals" {
  ad_group = google_ads_ad_group.summer_search_default.id
  status = "ENABLED"

  keyword {
    text = "summer deals"
    match_type = "PHRASE"
  }
}

resource "google_ads_ad_group_criterion" "summer_kw_summer_sale_exact" {
  ad_group = google_ads_ad_group.summer_search_default.id
  status = "ENABLED"
  cpc_bid_micros = 3500000

  keyword {
    text = "summer sale"
    match_type = "EXACT"
  }
}

resource "google_ads_campaign_criterion" "summer_neg_winter" {
  campaign = google_ads_campaign.summer_search.id
  status = "ENABLED"
  negative = true

  keyword {
    text = "winter"
    match_type = "BROAD"
  }
}

resource "google_ads_campaign_criterion" "summer_negatives_bulk" {
  campaign = google_ads_campaign.summer_search.id
  status = "ENABLED"

  negative_keyword {
    text = "free"
    match_type = "BROAD"
  }

  negative_keyword {
    text = "diy"
    match_type = "BROAD"
  }

  negative_keyword {
    text = "used"
    match_type = "BROAD"
  }
}

resource "google_ads_conversion_action" "lead" {
  name = "Summer Lead"
  type = "WEBPAGE"
  category = "SUBMIT_LEAD_FORM"
  status = "ENABLED"
  counting_type = "ONE_PER_CLICK"
  click_through_lookback_window_days = 30
  view_through_lookback_window_days = 1

  value_settings {
    default_value = 1
    default_currency_code = "USD"
    always_use_default_value = true
  }
}

resource "google_ads_call_asset" "main_phone" {
  country_code = "US"
  phone_number = "5551234567"
  call_conversion_reporting_state = "USE_RESOURCE_LEVEL_CALL_CONVERSION_ACTION"
  call_conversion_action = google_ads_conversion_action.lead.id
}

resource "google_ads_customer_asset" "main_phone_link" {
  asset = google_ads_call_asset.main_phone.id
  field_type = "CALL"
  status = "ENABLED"
}

resource "google_ads_sitelink_asset" "shop_deals" {
  link_text = "Shop Summer Deals"
  description1 = "Up to 40% off"
  description2 = "Limited-time savings"
  final_urls = ["https://www.google.com/?q=summer+deals"]
}

resource "google_ads_callout_asset" "free_shipping" {
  text = "Free Shipping"
}

resource "google_ads_structured_snippet_asset" "brands" {
  header = "Brands"
  values = ["Acme", "Globex", "Initech"]
}

resource "google_ads_campaign_asset" "summer_sitelink" {
  campaign = google_ads_campaign.summer_search.id
  asset = google_ads_sitelink_asset.shop_deals.id
  field_type = "SITELINK"
  status = "ENABLED"
}

resource "google_ads_campaign_asset" "summer_callout" {
  campaign = google_ads_campaign.summer_search.id
  asset = google_ads_callout_asset.free_shipping.id
  field_type = "CALLOUT"
  status = "ENABLED"
}

resource "google_ads_campaign_asset" "summer_snippet" {
  campaign = google_ads_campaign.summer_search.id
  asset = google_ads_structured_snippet_asset.brands.id
  field_type = "STRUCTURED_SNIPPET"
  status = "ENABLED"
}

resource "google_ads_campaign_criterion" "summer_proximity_warsaw" {
  campaign = google_ads_campaign.summer_search.id
  status = "ENABLED"

  proximity {
    latitude = 52.229675
    longitude = 21.012228
    radius = 15
    radius_units = "KILOMETERS"
  }
}

resource "google_ads_campaign_criterion" "summer_no_mobile" {
  campaign = google_ads_campaign.summer_search.id
  bid_modifier = 0

  device {
    type = "MOBILE"
  }
}

resource "google_ads_ad_group_ad" "summer_search_default_rsa" {
  ad_group = google_ads_ad_group.summer_search_default.id
  status = "ENABLED"

  ad {
    name = "Summer RSA"
    final_urls = ["https://www.google.com/?q=summer+deals", "https://www.google.com/"]

    responsive_search_ad {
      headline {
        text = "Summer Deals 2026"
        pin = "HEADLINE_1"
      }

      headline {
        text = "Save on Summer Gear"
      }

      headline {
        text = "Free Shipping This Summer"
      }

      description {
        text = "Limited-time offers across our summer range."
        pin = "DESCRIPTION_1"
      }

      description {
        text = "Order today and get free shipping on every box."
      }

      path1 = "summer"
      path2 = "deals"
    }
  }
}
