provider "google_ads" {
  customer_id = "1234567890"
}

resource "google_ads_campaign_budget" "fall" {
  name = "Fall 2026"
  amount_micros = 5000000
}

resource "google_ads_campaign" "fall_search" {
  name = "Fall 2026 — Search"
  advertising_channel_type = "SEARCH"
  campaign_budget = google_ads_campaign_budget.fall.id

  manual_cpc {
    enhanced_cpc_enabled = false
  }
}

resource "google_ads_ad_group" "fall_default" {
  name = "Default"
  campaign = google_ads_campaign.fall_search.id
}

resource "google_ads_campaign_criterion" "fall_lang_afar_typo" {
  campaign = google_ads_campaign.fall_search.id
  status = "ENABLED"

  language {
    language_constant = "languageConstants/1045"
  }
}

resource "google_ads_ad_group_ad" "fall_thin_rsa" {
  ad_group = google_ads_ad_group.fall_default.id

  ad {
    final_urls = ["https://example.com/fall"]

    responsive_search_ad {
      path1 = "FALL_promo_2026"
      path2 = "ok"

      headline {
        text = "Call 555-123-4567 for Deals"
      }

      headline {
        text = "An especially long fall promotional headline 2026"
      }

      description {
        text = "Reach out today and we will get back to you within one business day with a quote that beats the competition."
      }
    }
  }
}

resource "google_ads_campaign_criterion" "fall_exclude_unknown_age" {
  campaign = google_ads_campaign.fall_search.id
  negative = true

  age_range {
    type = "AGE_RANGE_UNDETERMINED"
  }
}
