locals {
  utm_campaign = "GH_Cookies_0708"
  landing = "https://www.example.com/ad-blocker"
  utm_base = "${local.landing}?utm_source=search&utm_campaign=${local.utm_campaign}"
  brand = "Ghostery"
}

provider "google_ads" {
  customer_id = "1234567890"
}

resource "google_ads_campaign_budget" "cookies" {
  name = "Budget ${local.utm_campaign}"
  amount_micros = 10000000
}

resource "google_ads_campaign" "cookies" {
  name = "Search — ${local.utm_campaign}"
  status = "ENABLED"
  advertising_channel_type = "SEARCH"
  campaign_budget = google_ads_campaign_budget.cookies.id
  contains_eu_political_advertising = "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING"

  manual_cpc {
    enhanced_cpc_enabled = false
  }
}

resource "google_ads_ad_group" "popups" {
  name = "Cookie Pop-Ups"
  campaign = google_ads_campaign.cookies.id
  status = "ENABLED"
  cpc_bid_micros = 1500000
}

resource "google_ads_ad_group_ad" "popups_rsa_a" {
  ad_group = google_ads_ad_group.popups.id
  status = "ENABLED"

  ad {
    final_urls = ["${local.utm_base}-rsa_a"]

    responsive_search_ad {
      headlines = [
        "Stop Cookie Pop-Ups for Good",
        "${local.brand} Ad Blocker",
        "Block Cookie Banners",
      ]
      descriptions = [
        "Browse without cookie consent interruptions.",
        "Free, open source, and private.",
      ]
    }
  }
}

resource "google_ads_ad_group_ad" "popups_rsa_b" {
  ad_group = google_ads_ad_group.popups.id
  status = "ENABLED"

  ad {
    final_urls = ["${local.utm_base}-rsa_b"]

    responsive_search_ad {
      headlines = [
        "Never Click Consent Again",
        "Try ${local.brand} Free",
        "One-Click Cookie Blocking",
      ]
      descriptions = [
        "Automatically handles cookie pop-ups for you.",
        "Trusted by millions of users worldwide.",
      ]
    }
  }
}
