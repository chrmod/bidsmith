# bidsmith design-doc config
#
# This file feeds `bidsmith design-doc render`, which produces an HTML design
# document you can print to PDF and attach to a Google Ads API
# Basic-Access (or Standard-Access) application.
#
# Fill in every field marked <FILL IN ...> before rendering. Google reviewers
# reject obviously templated submissions, so put real numbers and real
# sentences in §2 and §3 — describe your company's actual business and your
# team's actual use case, not the template's stock text.
#
# After editing, run:
#
#     bidsmith design-doc render
#
# That writes design-doc.html in the current directory. Open it in your
# browser, print to PDF, attach to Google's form.

# -----------------------------------------------------------------------------
# Applicant identity
# -----------------------------------------------------------------------------

# Legal entity name as it appears on your Google Ads account.
#
# The applicant is the company whose accounts bidsmith manages — even if a
# contractor operates it. In the API Center, set the company type to that
# company, NOT "Independent Developer": by Google's definition independent
# developers cannot build internal tools, and bidsmith is an internal tool.
applicant_legal_entity = "<FILL IN: e.g. Acme Marketing GmbH>"

# Your manager (MCC) account ID, 10 digits, no dashes.
# Find it in Google Ads UI -> top-right of the manager account.
manager_account_id = "<FILL IN: e.g. 1234567890>"

# Optional display name for the manager account (shown in parentheses
# after the ID on the cover page). Leave empty to omit.
manager_account_name = ""

# Person Google should contact about this application.
#
# Use an address on the applicant company's own domain, and set the API Center
# contact email to the same address. Google's compliance team flags
# applications tied to generic mailboxes (gmail.com, outlook.com, ...) and
# will ask you to re-confirm from a corporate address before proceeding.
contact_name = "<FILL IN: e.g. Jane Doe>"
contact_email = "<FILL IN: jane.doe@your-company-domain.com>"

# Optional: your company website. Used as a link in the contact section.
# Leave empty to omit.
company_url = ""

# -----------------------------------------------------------------------------
# Tool identity (defaults match upstream bidsmith — only change if you forked)
# -----------------------------------------------------------------------------

# tool_name = "bidsmith"
# source_repo_url = "https://github.com/chrmod/bidsmith"

# -----------------------------------------------------------------------------
# §2 — Business model (REWRITE in your own words)
#
# Google's compliance team asks for this almost verbatim: "describe the
# specific service or product your company provides. Who are your primary
# customers, and what is the 'value exchange' occurring on your platform?"
# A vague answer here is the most common reason an application bounces back
# with follow-up questions.
# -----------------------------------------------------------------------------

# The specific service or product your company sells — not a mission
# statement. Name the industry, the offering, and how customers buy it.
# Use a blank line between paragraphs.
core_business = """
<FILL IN: 2-4 sentences. What does your company actually sell, to whom,
and through which channel? e.g. "Acme runs three garden centres in the
Hamburg area and an online shop for garden furniture. Orders are placed
on acme.example and fulfilled from our own warehouse.">
"""

# One sentence: who buys it (customer segment, geography).
primary_customers = "<FILL IN: e.g. homeowners in northern Germany buying garden furniture online>"

# One sentence: who pays whom for what.
value_exchange = "<FILL IN: e.g. customers pay Acme directly for furniture ordered on acme.example>"

# -----------------------------------------------------------------------------
# §3 — Why the Google Ads API is essential (REWRITE in your own words)
#
# Three to five sentences describing why your team needs the Google Ads API
# and what problem bidsmith solves for you in production. Don't reuse the stock
# paragraph. Reviewers scan this and reject submissions that read like
# boilerplate. The rendered doc follows this with an auto-generated table
# mapping each workflow capability to the exact API service it requires, so
# focus here on your workflow and scale — the endpoint specifics are covered.
#
# Use a blank line between paragraphs.
# -----------------------------------------------------------------------------

why_this_tool_exists = """
<FILL IN: 3-5 sentences explaining your team's specific paid-search workflow,
the scale you operate at, and why doing it through the Google Ads UI is
painful enough to justify API access. Be concrete: mention real campaign
counts, real geographies, real review/audit needs.>
"""

# -----------------------------------------------------------------------------
# §3 — Who runs bidsmith
#
# One sentence describing your operator population. Example:
#   "a small number (currently 1-2) of named employees who hold the OAuth
#    refresh token and run bidsmith plan/apply from a workstation against
#    the Acme MCC."
# -----------------------------------------------------------------------------

who_uses_it_operators = "<FILL IN: how many operators, what they do>"

# -----------------------------------------------------------------------------
# §5 — Operation volume (override defaults if your usage differs)
# -----------------------------------------------------------------------------

# volume_typical_per_day = "well under 1,000 operations"
# volume_ceiling = "~5,000 operations"

# -----------------------------------------------------------------------------
# Optional: document date and closing note
# -----------------------------------------------------------------------------

# Defaults to today (YYYY-MM-DD). Override if you want to backdate.
# document_date = "2026-01-15"

# Optional paragraph rendered just before the contact section. Use it for a
# link to an example .bid repository, or anything else you want reviewers to
# read last.
# closing_note = ""
